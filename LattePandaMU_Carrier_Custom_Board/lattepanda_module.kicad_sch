		(uuid "a3074a5a-ce46-4f01-91fb-f6ae154b1e13")
	)
	(text "SPI is only used to connect to the BIOS ROM and discrete TPM\nCannot be used as a general SPI interface."
		(exclude_from_sim no)
		(at 344.678 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b6e00dd8-3517-4bc9-be39-1f9332d25be2")
	)
	(text "Unless the device clearly supports it,pulling it down enhnaces compatibility."
